{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "RunnerDeck",
  "version": "0.1.0",
  "identifier": "com.runnerdeck.desktop",
  "build": {
    "frontendDist": "../src"
  },
  "app": {
    "withGlobalTauri": true,
    "macOSPrivateApi": true,
    "windows": [
      {
        "label": "main",
        "title": "RunnerDeck",
        "width": 1200,
        "height": 880,
        "minWidth": 420,
        "minHeight": 520,
        "visible": false,
        "center": true
      },
      {
        "label": "widget",
        "title": "RunnerDeck Widget",
        "url": "widget.html",
        "width": 300,
        "height": 164,
        "resizable": false,
        "maximizable": false,
        "minimizable": false,
        "decorations": false,
        "transparent": true,
        "shadow": false,
        "skipTaskbar": true,
        "alwaysOnTop": false,
        "visible": false,
        "focus": false
      }
    ],
    "security": {
      "csp": "default-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' data:; connect-src ipc: http://ipc.localhost"
    }
  },
  "bundle": {
    "active": true,
    "targets": [
      "app",
      "dmg"
    ],
    "category": "DeveloperTool",
    "shortDescription": "Tray app for self-hosted CI runners",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "macOS": {
      "minimumSystemVersion": "11.0"
    }
  }
}